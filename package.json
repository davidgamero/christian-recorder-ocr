{
  "name": "christian-recorder-ocr",
  "version": "1.0.0",
  "private": true,
  "description": "Source-linked Christian Recorder OCR archive with static full-text search",
  "scripts": {
    "build": "python3 scripts/build.py && pagefind --site _site && python3 scripts/check_site.py",
